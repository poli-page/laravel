{
    "name": "poli-page/laravel",
    "description": "Laravel package for the Poli Page PDF rendering API",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "html", "template", "rendering", "poli-page", "laravel"],
    "homepage": "https://github.com/poli-page/laravel",
    "support": {
        "issues": "https://github.com/poli-page/laravel/issues",
        "source": "https://github.com/poli-page/laravel",
        "docs": "https://docs.poli.page"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^10.0 || ^11.0",
        "illuminate/contracts": "^10.0 || ^11.0",
        "illuminate/http": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "poli-page/sdk": "^0.1"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.5",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "php-http/guzzle7-adapter": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1",
        "orchestra/testbench": "^8.0 || ^9.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpstan/phpstan-mockery": "^1.0 || ^2.0",
        "larastan/larastan": "^2.0 || ^3.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "php-http/guzzle7-adapter": "Exposes Guzzle (already in every Laravel app) as a PSR-18 client for the SDK's discovery."
    },
    "autoload": {
        "psr-4": {
            "PoliPage\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PoliPage\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PoliPage\\Laravel\\PoliPageServiceProvider"
            ],
            "aliases": {
                "PoliPage": "PoliPage\\Laravel\\Facades\\PoliPage"
            }
        },
        "merge-plugin": {
            "include": ["composer.local.json"],
            "recurse": false,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion; fixed only in Laravel 12.61.1+. This package targets Laravel 10/11 (no advisory-clean release exists there) and does not generate temporary signed URLs.",
                "PKSA-3r5d-mb8f-1qw9": "CRLF injection in the default email validation rule; fixed only in Laravel 12.60+. This package does not use the email validation rule.",
                "PKSA-mdq4-51ck-6kdq": "CRLF injection in the default email validation rule (separate advisory ID, same root cause); fixed only in Laravel 12.60+. Not used by this package."
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M",
        "ci": ["@lint", "@analyse", "@test"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
