# Packagist serves the GitHub archive of the tag as the dist, and the archive
# leaves out every export-ignore path: the package ships src/, config/, the
# README, the CHANGELOG and the LICENSE, and nothing used only to develop it.
/.github export-ignore
/example-app export-ignore
/tests export-ignore
/.coderabbit.yaml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpstan.neon export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/RELEASING.md export-ignore
