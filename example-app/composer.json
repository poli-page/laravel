{
    "name": "poli-page/laravel-example",
    "description": "Example Laravel app demonstrating poli-page/laravel. Not published.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "poli-page/laravel": "@dev",
        "poli-page/sdk": "dev-main#7e16f75decd85d01c57904cd9ebef0c846bd0bb3"
    },
    "repositories": [
        { "type": "path", "url": "../", "options": { "symlink": true, "versions": { "poli-page/laravel": "0.1.0" } } },
        { "type": "vcs", "url": "https://github.com/poli-page/sdk-php", "no-api": true }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}
